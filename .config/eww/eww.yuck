;; ---------- polls ----------
(defpoll time      :interval "2s"  `date +%H:%M`)
(defpoll day       :interval "60s" `date +%A | tr a-z A-Z`)
(defpoll date      :interval "60s" `date "+%d %B %Y" | tr a-z A-Z`)
(defpoll greeting  :interval "300s"
  `h=$(date +%H); if [ "$h" -lt 12 ]; then echo "good morning"; elif [ "$h" -lt 18 ]; then echo "good afternoon"; else echo "good evening"; fi`)
(defpoll cpu_temp  :interval "5s"  `~/.config/eww/scripts/cputemp.sh`)
(defpoll battery   :interval "30s" `~/.config/eww/scripts/battery.sh`)

;; ---------- date + time (centre of the screen, a bit above middle) ----------
(defwidget datetime []
  (box :class "datetime" :orientation "v" :space-evenly false
       :halign "center" :valign "center"
    (label :class "dt-greeting" :show-truncated false :text greeting)
    (label :class "dt-day"      :show-truncated false :text day)
    (box   :class "dt-line"     :halign "center")
    (label :class "dt-time"     :show-truncated false :text time)
    (label :class "dt-date"     :show-truncated false :text date)))

(defwindow datetime
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "-120px"
                      :anchor "center")
  :stacking "bg"
  :exclusive false
  :focusable false
  (datetime))

;; ---------- stats card (top right) ----------
(defwidget stat [name text value]
  (box :class "stat" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "stat-name" :halign "start" :hexpand true
             :show-truncated false :text name)
      (label :class "stat-text" :halign "end"
             :show-truncated false :text text))
    (progress :class {value >= 85 ? "stat-bar danger" : "stat-bar"}
              :orientation "h"
              :value value)))

(defwidget stats []
  (box :class "card" :orientation "v" :space-evenly false
    (stat :name "CPU"
          :text "${round(EWW_CPU.avg, 0)}%"
          :value {EWW_CPU.avg})
    (stat :name "RAM"
          :text "${round(EWW_RAM.used_mem / 1073741824, 1)} / ${round(EWW_RAM.total_mem / 1073741824, 1)} GB"
          :value {EWW_RAM.used_mem_perc})
    (stat :name "DISK"
          :text "${round(EWW_DISK["/"].used / 1073741824, 0)} / ${round(EWW_DISK["/"].total / 1073741824, 0)} GB"
          :value {EWW_DISK["/"].used_perc})
    (stat :name "TEMP"
          :text "${cpu_temp}°C"
          :value cpu_temp)
    (stat :name "BAT"
          :text "${battery}%"
          :value battery)))

(defwindow statscard
  :monitor 0
  :geometry (geometry :x "24px"
                      :y "24px"
                      :width "250px"
                      :anchor "top right")
  :stacking "bg"
  :exclusive false
  :focusable false
  (stats))

;; ================= control center =================
(defvar control_center_open false)
(defvar control_center_expand "")   ;; "" | network | bluetooth
(defvar control_center_confirm "")  ;; "" | logout | reboot | shutdown

;; Standalone menu state. Cached values are loaded before each popup opens.
(defvar wifi_menu_open false)
(defvar bluetooth_menu_open false)
(defvar audio_menu_open false)
(defvar audio_menu_outputs_open false)
(defvar audio_menu_sources_open false)

(defpoll control_center_net   :interval "5s" :run-while {control_center_open || wifi_menu_open} :initial '{"wifi":false,"kind":"none","title":"Wi-Fi","sub":""}' `~/.config/eww/scripts/control-center.sh net status`)
(defpoll control_center_wifi  :interval "8s" :run-while {(control_center_open && control_center_expand == "network") || wifi_menu_open} :initial '{"n":0,"items":[]}' `~/.config/eww/scripts/control-center.sh net list`)
(defpoll control_center_bt    :interval "4s" :run-while {control_center_open || bluetooth_menu_open} :initial '{"powered":false,"count":0,"summary":"","devices":[]}' `~/.config/eww/scripts/control-center.sh bt status`)
(defpoll control_center_audio :interval "2s" :run-while {control_center_open || audio_menu_open} :initial '{"sink":{"vol":0,"muted":false},"source":{"vol":0,"muted":false},"sinks":[],"sources":[]}' `~/.config/eww/scripts/control-center.sh au status`)
(defpoll control_center_sys   :interval "5s" :run-while control_center_open :initial '{"profile":"balanced","brightness":50}' `~/.config/eww/scripts/control-center.sh sys status`)

;; Slider values live in their own light vars so labels follow changes.
(defpoll control_center_vol_sink   :interval "2s" :run-while {control_center_open || audio_menu_open} :initial "0" `~/.config/eww/scripts/control-center.sh au getvol sink`)
(defpoll control_center_vol_source :interval "2s" :run-while {control_center_open || audio_menu_open} :initial "0" `~/.config/eww/scripts/control-center.sh au getvol source`)
(defpoll control_center_bright     :interval "5s" :run-while control_center_open :initial "50" `~/.config/eww/scripts/control-center.sh sys getbright`)

(defwidget control-center-tile [icon title sub on toggle expand open]
  (box :class "control-center-tile" :orientation "h" :space-evenly false :spacing 12
    (eventbox :class "control-center-hit" :cursor "pointer" :onclick toggle
      (label :class {on ? "control-center-ico on" : "control-center-ico"} :text icon))
    (eventbox :class "control-center-hit" :cursor "pointer" :hexpand true :onclick expand
      (box :orientation "v" :space-evenly false :valign "center"
        (label :class "control-center-title" :halign "start" :limit-width 26 :text title)
        (label :class "control-center-sub" :halign "start" :limit-width 34 :text sub)))
    (eventbox :class "control-center-hit" :cursor "pointer" :onclick expand
      (label :class "control-center-chev" :text {open ? "" : ""}))))

(defwidget control-center-slider [icon value muted onchange onmute]
  (box :class "control-center-slider" :orientation "h" :space-evenly false :spacing 12 :hexpand true
    (eventbox :class "control-center-hit" :cursor "pointer" :onclick onmute
      (label :class {muted ? "control-center-ico muted" : "control-center-ico"} :text icon))
    (scale :class "control-center-scale" :hexpand true :min 0 :max 101 :value value :onchange onchange)
    (label :class "control-center-pct" :text "${round(value, 0)}%")))

(defwidget control-center-seg [prof icon label]
  (eventbox :class "control-center-hit" :cursor "pointer" :hexpand true :onclick "~/.config/eww/scripts/control-center.sh sys prof ${prof}"
    (box :class {control_center_sys.profile == prof ? "control-center-seg active" : "control-center-seg"} :orientation "h" :space-evenly false :halign "center" :spacing 6
      (label :text icon) (label :text label))))

(defwidget control-center-pbtn [icon act cls]
  (eventbox :class "control-center-hit" :cursor "pointer" :hexpand true :onclick act
    (label :class "control-center-pbtn ${cls}" :text icon)))

(defwidget control-center-network []
  (box :class "control-center-block" :orientation "v" :space-evenly false
    (control-center-tile :icon {control_center_net.kind == "ethernet" ? "" : control_center_net.wifi ? "" : ""}
             :title {control_center_net.title} :sub {control_center_net.sub} :on {control_center_net.wifi}
             :toggle "~/.config/eww/scripts/control-center.sh net toggle"
             :expand {control_center_expand == "network" ? "eww update control_center_expand=" : "eww update control_center_expand=network"}
             :open {control_center_expand == "network"})
    (revealer :transition "slidedown" :duration "200ms" :reveal {control_center_expand == "network"}
      (box :class "control-center-list" :orientation "v" :space-evenly false
        (label :class "control-center-sub" :halign "start" :visible {control_center_wifi.n == 0} :text "Scanning…")
        (for n in {control_center_wifi.items}
          (eventbox :class "control-center-hit" :cursor "pointer" :onclick "~/.config/eww/scripts/control-center.sh net connect ${n.idx}"
            (box :class {n.active ? "control-center-item active" : "control-center-item"} :orientation "h" :space-evenly false :spacing 10
              (label :class "control-center-item-name" :hexpand true :halign "start" :limit-width 28 :text {n.ssid})
              (label :class "control-center-item-meta" :text {n.secure ? "" : ""})
              (label :class "control-center-item-meta" :text "${n.signal}%"))))))))

(defwidget control-center-bluetooth []
  (box :class "control-center-block" :orientation "v" :space-evenly false
    (control-center-tile :icon "" :title "Bluetooth" :sub {control_center_bt.summary} :on {control_center_bt.powered}
             :toggle "~/.config/eww/scripts/control-center.sh bt power"
             :expand {control_center_expand == "bluetooth" ? "eww update control_center_expand=" : "eww update control_center_expand=bluetooth"}
             :open {control_center_expand == "bluetooth"})
    (revealer :transition "slidedown" :duration "200ms" :reveal {control_center_expand == "bluetooth"}
      (box :class "control-center-list" :orientation "v" :space-evenly false
        (label :class "control-center-sub" :halign "start" :visible {control_center_bt.count == 0}
               :text {control_center_bt.powered ? "No paired devices" : "Bluetooth is off"})
        (for d in {control_center_bt.devices}
          (eventbox :class "control-center-hit" :cursor "pointer" :onclick "~/.config/eww/scripts/control-center.sh bt device ${d.mac}"
            (box :class {d.connected ? "control-center-item active" : "control-center-item"} :orientation "h" :space-evenly false :spacing 10
              (label :class "control-center-item-name" :hexpand true :halign "start" :limit-width 28 :text {d.name})
              (label :class "control-center-item-meta" :visible {d.battery >= 0} :text "${d.battery}%")
              (label :class "control-center-item-meta" :text {d.connected ? "connected" : ""}))))))))

(defwidget control-center-audio []
  (box :class "control-center-block" :orientation "v" :space-evenly false :spacing 8
    (label :class "control-center-cap" :halign "start" :text "AUDIO")
    (label :class "control-center-sub" :halign "start" :text "OUTPUT")
    (box :orientation "h" :space-evenly false :spacing 6
      (control-center-slider :icon {control_center_audio.sink.muted ? "" : ""} :value control_center_vol_sink :muted {control_center_audio.sink.muted}
                 :onchange "~/.config/eww/scripts/control-center.sh au vol sink {}"
                 :onmute "~/.config/eww/scripts/control-center.sh au mute sink")
      (eventbox :class "control-center-hit" :cursor "pointer"
                :onclick {audio_menu_outputs_open ? "eww update audio_menu_outputs_open=false" : "eww update audio_menu_outputs_open=true"}
        (label :class "control-center-chev" :text {audio_menu_outputs_open ? "" : ""})))
    (revealer :transition "slidedown" :duration "200ms" :reveal audio_menu_outputs_open
      (box :class "control-center-list" :orientation "v" :space-evenly false
        (for s in {control_center_audio.sinks}
          (eventbox :class "control-center-hit" :cursor "pointer" :onclick "~/.config/eww/scripts/control-center.sh au set sink ${s.idx}"
            (box :class {s.active ? "control-center-item active" : "control-center-item"} :orientation "h" :space-evenly false
              (label :class "control-center-item-name" :halign "start" :limit-width 38 :text {s.desc}))))))
    (label :class "control-center-sub" :halign "start" :text "INPUT / MICROPHONE")
    (box :orientation "h" :space-evenly false :spacing 6
      (control-center-slider :icon {control_center_audio.source.muted ? "" : ""} :value control_center_vol_source :muted {control_center_audio.source.muted}
                 :onchange "~/.config/eww/scripts/control-center.sh au vol source {}"
                 :onmute "~/.config/eww/scripts/control-center.sh au mute source")
      (eventbox :class "control-center-hit" :cursor "pointer"
                :onclick {audio_menu_sources_open ? "eww update audio_menu_sources_open=false" : "eww update audio_menu_sources_open=true"}
        (label :class "control-center-chev" :text {audio_menu_sources_open ? "" : ""})))
    (revealer :transition "slidedown" :duration "200ms" :reveal audio_menu_sources_open
      (box :class "control-center-list" :orientation "v" :space-evenly false
        (for s in {control_center_audio.sources}
          (eventbox :class "control-center-hit" :cursor "pointer" :onclick "~/.config/eww/scripts/control-center.sh au set source ${s.idx}"
            (box :class {s.active ? "control-center-item active" : "control-center-item"} :orientation "h" :space-evenly false
              (label :class "control-center-item-name" :halign "start" :limit-width 38 :text {s.desc}))))))))

(defwidget control-center-system []
  (box :class "control-center-block" :orientation "v" :space-evenly false :spacing 10
    (label :class "control-center-cap" :halign "start" :text "SYSTEM")
    (control-center-slider :icon "" :value control_center_bright :muted false
               :onchange "~/.config/eww/scripts/control-center.sh sys bright {}" :onmute "true")
    (box :class "control-center-segs" :orientation "h" :spacing 6
      (control-center-seg :prof "power-saver" :icon "" :label "Saver")
      (control-center-seg :prof "balanced"    :icon "" :label "Balanced")
      (control-center-seg :prof "performance" :icon "" :label "Perf"))
    (box :orientation "h" :spacing 14
      (stat :name "CPU" :text "${round(EWW_CPU.avg, 0)}%" :value {EWW_CPU.avg})
      (stat :name "RAM" :text "${round(EWW_RAM.used_mem_perc, 0)}%" :value {EWW_RAM.used_mem_perc}))
    (box :orientation "h" :spacing 14
      (stat :name "TEMP" :text "${cpu_temp}°C" :value cpu_temp)
      (stat :name "BAT" :text "${battery}%" :value battery))))

(defwidget control-center-power []
  (box :class "control-center-block" :orientation "v" :space-evenly false :spacing 8
    (box :orientation "h" :spacing 8
      (control-center-pbtn :icon "" :cls "" :act "~/.config/eww/scripts/control-center.sh pw do lock")
      (control-center-pbtn :icon "" :cls "" :act "~/.config/eww/scripts/control-center.sh pw do suspend")
      (control-center-pbtn :icon "" :cls "" :act "eww update control_center_confirm=logout")
      (control-center-pbtn :icon "" :cls "" :act "eww update control_center_confirm=reboot")
      (control-center-pbtn :icon "" :cls "danger" :act "eww update control_center_confirm=shutdown"))
    (revealer :transition "slidedown" :duration "150ms" :reveal {control_center_confirm != ""}
      (box :class "control-center-confirm" :orientation "h" :space-evenly false :spacing 8
        (label :class "control-center-confirm-text" :hexpand true :halign "start" :text "Confirm ${control_center_confirm}?")
        (eventbox :class "control-center-hit" :cursor "pointer" :onclick "eww update control_center_confirm="
          (label :class "control-center-btn" :text "Cancel"))
        (eventbox :class "control-center-hit" :cursor "pointer" :onclick "~/.config/eww/scripts/control-center.sh pw do ${control_center_confirm}"
          (label :class "control-center-btn danger" :text "Yes"))))))

(defwidget control-center []
  (box :class "control-center-panel" :orientation "v" :space-evenly false :spacing 10
    (control-center-network) (control-center-bluetooth) (control-center-audio) (control-center-system) (control-center-power)))

;; y = waybar margin-top (10) + bar height + gap; adjust after `hyprctl layers`
(defwindow control-center
  :monitor 0
  :geometry (geometry :x "24px" :y "10px" :width "380px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (control-center))

;; The popup_x window argument is supplied by control-center.sh at click time.
;; 50px = 10px top margin + 30px bar + 10px visual gap.
(defwindow wifi-menu [popup_x]
  :monitor 0
  :geometry (geometry :x popup_x :y "50px" :width "380px" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "control-center-panel control-center-popup" :orientation "v" :space-evenly false
    (control-center-network)))

(defwindow bluetooth-menu [popup_x]
  :monitor 0
  :geometry (geometry :x popup_x :y "50px" :width "380px" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "control-center-panel control-center-popup" :orientation "v" :space-evenly false
    (control-center-bluetooth)))

(defwindow audio-menu [popup_x]
  :monitor 0
  :geometry (geometry :x popup_x :y "50px" :width "380px" :anchor "top left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "control-center-panel control-center-popup" :orientation "v" :space-evenly false
    (control-center-audio)))


;; invisible full-screen click catcher: closes the panel
(defwindow control-center-closer
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :exclusive false
  :focusable false
  (eventbox :onclick "~/.config/eww/scripts/control-center.sh win close" (box)))
