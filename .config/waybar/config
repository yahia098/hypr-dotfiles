{
    "layer": "top",

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "custom/separator",
        "network",
        "custom/separator",
        "pulseaudio",
	"custom/separator",
        "group/system",
	"custom/separator",
	"custom/notification",
        "custom/separator",
        "battery",
        "custom/separator",
        "clock",
        "custom/separator",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "sort-by-number": true,
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "tooltip": false,
        "rewrite": {
            "": "Desktop"
        }
    },

    "custom/separator": {
        "format": "│",
        "tooltip": false
    },

    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "children-class": "system-group",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/system",
            "cpu",
            "memory",
            "temperature",
            "custom/powerprofile"
        ]
    },

    "custom/system": {
        "format": "",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {}%",
        "tooltip": false
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },

    "custom/powerprofile": {
        "exec": "powerprofilesctl get",
        "interval": 5,
        "format": "󰚥 {}",
        "tooltip": true,
        "on-click": "powerprofilesctl set power-saver",
        "on-click-middle": "powerprofilesctl set balanced",
        "on-click-right": "powerprofilesctl set performance"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": " {capacity}% {icon}",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "format-icons": {
            "default": ["", ""]
        }
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "interval": 2,
        "on-click": "nm-connection-editor"
    },

    "clock": {
        "interval": 1,
        "format": " {:%H:%M}",
        "format-alt": " {:%A %d %B %Y}",
        "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}"
    },

    "custom/notification": {
        "format": " {}",
        "exec": "swaync-client -c",
        "interval": 2,
        "on-click": "swaync-client -t"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
